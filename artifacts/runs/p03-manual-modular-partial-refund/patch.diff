+# ---------------------------------------------------------------------------
+# Rounding determinism (Frozen Rule 4)
+# ---------------------------------------------------------------------------
+
+def test_rounding_across_units_sums_to_line_total_minus_allocated(client):
+    # TSHIRT x3 with SAVE25 (25%):
+    # subtotal = 6000, discount = (6000*25+50)//100 = 1500
+    # W = 6000, TSHIRT allocated = 1500, q = 3
+    # Unit refunds: floor(1500*1/3)-0=500, floor(1500*2/3)-500=1000-500=500, 1500-1000=500
+    # Each unit: 2000-500=1500, total = 4500 = 6000-1500 ✓
+    order = client.order_with({"TSHIRT": 3}, "SAVE25")
+    oid = order["order_id"]
+    r1 = partial_refund(client, oid, [{"sku": "TSHIRT", "quantity": 1}])
+    r2 = partial_refund(client, oid, [{"sku": "TSHIRT", "quantity": 1}])
+    r3 = partial_refund(client, oid, [{"sku": "TSHIRT", "quantity": 1}])
+    total = r1.body["amount_cents"] + r2.body["amount_cents"] + r3.body["amount_cents"]
+    expected_line_total_after_discount = 6000 - 1500
+    assert total == expected_line_total_after_discount
