-"""Full refund: uses the pricing result recorded at checkout."""
+"""Refund logic: full-order and partial (item-level) refunds."""
 
 from __future__ import annotations
 
 from .errors import ApiError
 
 
+def _allocate_discount(lines: list[dict], discount_cents: int) -> dict[str, int]:
+    """
+    Allocate discount_cents across coupon-eligible lines.
+
+    Rule (Frozen Rule 3):
+      Let D = discount_cents, W = sum of line_total_cents over eligible lines.
+      Line i gets floor(D * w_i / W).
+      Remainder cents go one-each to lines by descending (D * w_i mod W),
+      breaking ties by ascending line position.
+
+    Returns a dict mapping sku -> allocated discount cents.
+    """
+    if discount_cents == 0:
+        return {}
+
+    eligible = [(i, ln) for i, ln in enumerate(lines) if ln["coupon_eligible"]]
+    W = sum(ln["quantity"] * ln["unit_price_cents"] for _, ln in eligible)
+    if W == 0:
+        return {}
+
+    base: dict[str, int] = {}
+    remainders: list[tuple[int, int, str]] = []  # (-remainder, position, sku)
+    total_floor = 0
+    for pos, ln in eligible:
+        sku = ln["sku"]
+        w_i = ln["quantity"] * ln["unit_price_cents"]
+        floor_val = (discount_cents * w_i) // W
+        remainder = (discount_cents * w_i) % W
+        base[sku] = floor_val
+        total_floor += floor_val
+        remainders.append((-remainder, pos, sku))  # negated for descending sort
+
+    extra = discount_cents - total_floor
+    remainders.sort()  # descending remainder, then ascending position
+    for i in range(extra):
+        _, _, sku = remainders[i]
+        base[sku] = base[sku] + 1
+
+    return base
+
+
+def _line_discount_for_units(allocated: int, quantity: int, j: int, n: int) -> int:
+    """
+    Discount for refunding units j+1 through j+n of a line (Frozen Rule 4).
+    allocated = L (total discount allocated to this line)
+    quantity = q
+    j = units already refunded
+    n = units being refunded now
+    """
+    return (allocated * (j + n)) // quantity - (allocated * j) // quantity
+
+
+def _compute_item_refund(lines: list[dict], discount_alloc: dict[str, int], items: list[dict]) -> list[dict]:
+    """
+    Compute per-item refund amounts.
+    Returns list of {sku, quantity, amount_cents}.
+    """
+    line_by_sku = {ln["sku"]: ln for ln in lines}
+    result = []
+    for item in items:
+        sku = item["sku"]
+        n = item["quantity"]
+        ln = line_by_sku[sku]
+        j = ln["refunded_quantity"]
+        unit_price = ln["unit_price_cents"]
+        L = discount_alloc.get(sku, 0)
+        q = ln["quantity"]
+        discount = _line_discount_for_units(L, q, j, n)
+        amount = n * unit_price - discount
+        result.append({"sku": sku, "quantity": n, "amount_cents": amount})
+    return result
+
+
 def refund_order(store, order_id: str) -> dict:
+    """Full refund: refunds all units not already refunded."""
     order = store.get_order(order_id)
     if order is None:
