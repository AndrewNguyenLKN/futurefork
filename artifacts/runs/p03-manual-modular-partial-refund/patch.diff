diff --git a/tests/test_partial_refund.py b/tests/test_partial_refund.py
new file mode 100644
index 0000000..ca129d8
--- /dev/null
+++ b/tests/test_partial_refund.py
@@ -0,0 +1,273 @@
+"""Tests for POST /orders/{order_id}/refunds (partial/item-level refunds)."""
+
+from __future__ import annotations
+
+
+# ---------------------------------------------------------------------------
+# Helpers
+# ---------------------------------------------------------------------------
+
+def partial_refund(client, order_id, items):
+    return client.post(f"/orders/{order_id}/refunds", {"items": items})
+
+
+# ---------------------------------------------------------------------------
+# Happy-path: single item
+# ---------------------------------------------------------------------------
+
+def test_partial_refund_single_eligible_item_no_discount(client):
+    # MUG: 1250 cents, no coupon -> discount_cents = 0
+    order = client.order_with({"MUG": 2})
+    resp = partial_refund(client, order["order_id"], [{"sku": "MUG", "quantity": 1}])
+    assert resp.status == 201
+    body = resp.body
+    assert body["refund_id"] == "ref_0001"
+    assert body["order_id"] == order["order_id"]
+    # status is always "refunded" in a successful response
+    assert body["status"] == "refunded"
+    assert body["items"] == [{"sku": "MUG", "quantity": 1, "amount_cents": 1250}]
+    assert body["amount_cents"] == 1250
+    # remaining: captured(2500) - refunded(0) - this(1250) = 1250
+    assert body["remaining_refundable_cents"] == 1250
+    # persisted order should still be 'paid', not fully refunded
+    assert client.get(f"/orders/{order['order_id']}").body["status"] == "paid"
+
+
+def test_partial_refund_completes_order(client):
+    order = client.order_with({"MUG": 1})
+    resp = partial_refund(client, order["order_id"], [{"sku": "MUG", "quantity": 1}])
+    assert resp.status == 201
+    assert resp.body["status"] == "refunded"
+    assert resp.body["remaining_refundable_cents"] == 0
+    # confirm persisted order status via GET
+    assert client.get(f"/orders/{order['order_id']}").body["status"] == "refunded"
+
+
+def test_partial_refund_discounted_item_allocates_discount(client):
+    # TSHIRT x2 + GIFTCARD x1, SAVE10 (10%)
+    # eligible W = 4000, D = 400
+    # TSHIRT allocated = floor(400*4000/4000) = 400
+    # GIFTCARD not eligible -> 0
+    # Refund 1 TSHIRT (j=0, n=1, q=2, L=400):
+    #   discount = floor(400*1/2) - floor(400*0/2) = 200 - 0 = 200
+    #   amount = 1*2000 - 200 = 1800
+    order = client.order_with({"TSHIRT": 2, "GIFTCARD": 1}, "SAVE10")
+    resp = partial_refund(client, order["order_id"], [{"sku": "TSHIRT", "quantity": 1}])
+    assert resp.status == 201
+    assert resp.body["status"] == "refunded"
+    assert resp.body["items"] == [{"sku": "TSHIRT", "quantity": 1, "amount_cents": 1800}]
+    assert resp.body["amount_cents"] == 1800
+
+
+def test_partial_refund_ineligible_item_gets_no_discount(client):
+    # GIFTCARD is not coupon-eligible, so no allocated discount even with coupon
+    order = client.order_with({"TSHIRT": 1, "GIFTCARD": 1}, "SAVE10")
+    resp = partial_refund(client, order["order_id"], [{"sku": "GIFTCARD", "quantity": 1}])
+    assert resp.status == 201
+    assert resp.body["status"] == "refunded"
+    assert resp.body["items"] == [{"sku": "GIFTCARD", "quantity": 1, "amount_cents": 5000}]
+    assert resp.body["amount_cents"] == 5000
+
+
+# ---------------------------------------------------------------------------
+# Multiple items in one operation
+# ---------------------------------------------------------------------------
+
+def test_partial_refund_multiple_items_sums_amounts(client):
+    # MUG x1 (1250) + TSHIRT x1 (2000), no coupon
+    order = client.order_with({"MUG": 1, "TSHIRT": 1})
+    resp = partial_refund(client, order["order_id"],
+                          [{"sku": "MUG", "quantity": 1}, {"sku": "TSHIRT", "quantity": 1}])
+    assert resp.status == 201
+    assert resp.body["status"] == "refunded"
+    assert resp.body["amount_cents"] == 3250
+    # all units refunded -> persisted order is also refunded
+    assert client.get(f"/orders/{order['order_id']}").body["status"] == "refunded"
+
+
+# ---------------------------------------------------------------------------
+# Sequential partial refunds
+# ---------------------------------------------------------------------------
+
+def test_sequential_refunds_track_already_refunded_units(client):
+    # TSHIRT x2 + GIFTCARD x1, SAVE10
+    # TSHIRT allocated discount = 400, q=2
+    # First refund: 1 TSHIRT (j=0, n=1): discount=200, amount=1800
+    # Second refund: 1 TSHIRT (j=1, n=1): discount=floor(400*2/2)-floor(400*1/2)=400-200=200, amount=1800
+    order = client.order_with({"TSHIRT": 2, "GIFTCARD": 1}, "SAVE10")
+    oid = order["order_id"]
+    r1 = partial_refund(client, oid, [{"sku": "TSHIRT", "quantity": 1}])
+    assert r1.body["status"] == "refunded"
+    assert r1.body["items"][0]["amount_cents"] == 1800
+    r2 = partial_refund(client, oid, [{"sku": "TSHIRT", "quantity": 1}])
+    assert r2.body["status"] == "refunded"
+    assert r2.body["items"][0]["amount_cents"] == 1800
+    # GIFTCARD still outstanding -> persisted order is still 'paid'
+    assert client.get(f"/orders/{oid}").body["status"] == "paid"
+
+
+def test_sequential_refunds_total_equals_captured(client):
+    # Refund each item individually and verify the total equals captured
+    order = client.order_with({"TSHIRT": 2, "GIFTCARD": 1}, "SAVE10")
+    oid = order["order_id"]
+    captured = order["payment"]["captured_cents"]  # 8600
+
+    r1 = partial_refund(client, oid, [{"sku": "TSHIRT", "quantity": 1}])
+    r2 = partial_refund(client, oid, [{"sku": "TSHIRT", "quantity": 1}])
+    r3 = partial_refund(client, oid, [{"sku": "GIFTCARD", "quantity": 1}])
+
+    total = r1.body["amount_cents"] + r2.body["amount_cents"] + r3.body["amount_cents"]
+    assert total == captured
+    assert r3.body["status"] == "refunded"
+    assert r3.body["remaining_refundable_cents"] == 0
+    # all units now refunded -> persisted order is refunded
+    assert client.get(f"/orders/{oid}").body["status"] == "refunded"
+
+
+# ---------------------------------------------------------------------------
+# Refund IDs share one sequence with full-refund endpoint
+# ---------------------------------------------------------------------------
+
+def test_refund_ids_share_sequence_with_full_refund(client):
+    # Partial refund first -> ref_0001; then full refund of second order -> ref_0002
+    o1 = client.order_with({"MUG": 2}, key="k1")
+    o2 = client.order_with({"MUG": 1}, key="k2")
+    r1 = partial_refund(client, o1["order_id"], [{"sku": "MUG", "quantity": 1}])
+    r2 = client.post(f"/orders/{o2['order_id']}/refund")
+    assert r1.body["refund_id"] == "ref_0001"
+    assert r2.body["refund_id"] == "ref_0002"
+
+
+# ---------------------------------------------------------------------------
+# 404: unknown order
+# ---------------------------------------------------------------------------
+
+def test_partial_refund_unknown_order_is_404(client):
+    resp = partial_refund(client, "order_9999", [{"sku": "MUG", "quantity": 1}])
+    assert resp.status == 404
+    assert resp.body["error"]["code"] == "order_not_found"
+
+
+# ---------------------------------------------------------------------------
+# 422: validation errors
+# ---------------------------------------------------------------------------
+
+def test_partial_refund_empty_items_is_422(client):
+    order = client.order_with({"MUG": 1})
+    resp = partial_refund(client, order["order_id"], [])
+    assert resp.status == 422
+    assert resp.body["error"]["code"] == "invalid_refund_items"
+
+
+def test_partial_refund_unknown_sku_is_422(client):
+    order = client.order_with({"MUG": 1})
+    resp = partial_refund(client, order["order_id"], [{"sku": "NOSUCHSKU", "quantity": 1}])
+    assert resp.status == 422
+    assert resp.body["error"]["code"] == "invalid_refund_items"
+
+
+def test_partial_refund_sku_not_in_order_is_422(client):
+    order = client.order_with({"MUG": 1})
+    resp = partial_refund(client, order["order_id"], [{"sku": "TSHIRT", "quantity": 1}])
+    assert resp.status == 422
+    assert resp.body["error"]["code"] == "invalid_refund_items"
+
+
+def test_partial_refund_quantity_below_1_is_422(client):
+    order = client.order_with({"MUG": 1})
+    resp = partial_refund(client, order["order_id"], [{"sku": "MUG", "quantity": 0}])
+    assert resp.status == 422
+    assert resp.body["error"]["code"] == "invalid_refund_items"
+
+
+def test_partial_refund_duplicate_sku_is_422(client):
+    order = client.order_with({"MUG": 2})
+    resp = partial_refund(client, order["order_id"],
+                          [{"sku": "MUG", "quantity": 1}, {"sku": "MUG", "quantity": 1}])
+    assert resp.status == 422
+    assert resp.body["error"]["code"] == "invalid_refund_items"
+
+
+# ---------------------------------------------------------------------------
+# 409: refund exceeds order
+# ---------------------------------------------------------------------------
+
+def test_partial_refund_quantity_exceeds_available_is_409(client):
+    order = client.order_with({"MUG": 1})
+    resp = partial_refund(client, order["order_id"], [{"sku": "MUG", "quantity": 2}])
+    assert resp.status == 409
+    assert resp.body["error"]["code"] == "refund_exceeds_order"
+
+
+def test_partial_refund_on_fully_refunded_order_is_409(client):
+    order = client.order_with({"MUG": 1})
+    partial_refund(client, order["order_id"], [{"sku": "MUG", "quantity": 1}])
+    resp = partial_refund(client, order["order_id"], [{"sku": "MUG", "quantity": 1}])
+    assert resp.status == 409
