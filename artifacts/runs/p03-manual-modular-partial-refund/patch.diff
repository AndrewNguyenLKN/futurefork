+        qty = item.get("quantity", 0)
+        if not isinstance(qty, int) or qty < 1:
+            raise ApiError(422, "invalid_refund_items", f"quantity must be at least 1 for sku {sku!r}")
+        if sku in seen_skus:
+            raise ApiError(422, "invalid_refund_items", f"sku {sku!r} appears more than once")
+        seen_skus.add(sku)
+
+    lines = store.order_lines(order_id)
+    line_by_sku = {ln["sku"]: ln for ln in lines}
+
+    for item in request_items:
+        sku = item["sku"]
+        qty = item["quantity"]
+        if sku not in line_by_sku:
+            raise ApiError(422, "invalid_refund_items", f"sku {sku!r} is not in order {order_id}")
+        ln = line_by_sku[sku]
+        remaining = ln["quantity"] - ln["refunded_quantity"]
+        if qty > remaining:
+            raise ApiError(
+                409, "refund_exceeds_order",
+                f"sku {sku!r}: requested {qty} but only {remaining} units are still refundable"
+            )
+
+    pricing = store.order_pricing(order)
+    discount_alloc = _allocate_discount(lines, pricing.discount_cents)
+    item_refunds = _compute_item_refund(lines, discount_alloc, request_items)
+    total_amount = sum(r["amount_cents"] for r in item_refunds)
+
+    # Compute remaining refundable after this operation
+    already_refunded = store.order_refunded_cents(order_id)
+    remaining_refundable = order["captured_cents"] - already_refunded - total_amount
+
     refund_id = store.next_id("ref")
-    store.save_refund(refund_id, order_id, amount)
-    return {"refund_id": refund_id, "order_id": order_id, "status": "refunded", "amount_cents": amount}
+    store.save_refund(refund_id, order_id, total_amount, request_items)
+
+    return {
+        "refund_id": refund_id,
+        "order_id": order_id,
+        "status": "refunded",
+        "items": item_refunds,
+        "amount_cents": total_amount,
+        "remaining_refundable_cents": remaining_refundable,
+    }
