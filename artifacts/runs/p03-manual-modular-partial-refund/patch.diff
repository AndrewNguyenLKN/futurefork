+
+
+def refund_items(store, order_id: str, request_items: list[dict]) -> dict:
+    """
+    Partial refund: refund specified items.
+    request_items: list of {sku, quantity}
+    """
+    order = store.get_order(order_id)
+    if order is None:
+        raise ApiError(404, "order_not_found", f"order {order_id} does not exist")
+
+    # Validate request items
+    if not request_items:
