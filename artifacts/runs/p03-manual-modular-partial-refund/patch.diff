-    amount = min(store.order_pricing(order).total_cents, order["captured_cents"])
+
+    lines = store.order_lines(order_id)
+    pricing = store.order_pricing(order)
+    discount_alloc = _allocate_discount(lines, pricing.discount_cents)
+
+    # Build items list: all units not yet refunded
+    items = [
+        {"sku": ln["sku"], "quantity": ln["quantity"] - ln["refunded_quantity"]}
+        for ln in lines
+        if ln["quantity"] > ln["refunded_quantity"]
