+++ b/tests/test_partial_refund.py
@@ -0,0 +1,294 @@
+"""Tests for POST /orders/{order_id}/refunds (partial item-level refund)."""
+
+# ---------------------------------------------------------------------------
+# Numeric fixtures (hand-verified against the allocation rules in the spec)
+#
+# SAVE10 = 10%, SAVE25 = 25%
+# TSHIRT = 2000 cents  coupon_eligible=True
+# MUG    = 1250 cents  coupon_eligible=True
+# GIFTCARD = 5000 cents  coupon_eligible=False
+#
+# Allocation rule (from spec):
+#   D  = order discount_cents
+#   W  = sum of line_total_cents over coupon-eligible lines
+#   Line i floor = D * w_i // W
+#   Remaining cents to lines sorted by descending (D*w_i % W), ties by position asc
+#
+# Unit discount rule:
+#   n units of line (q total, L allocated, j already refunded):
+#     discount = (L*(j+n))//q - (L*j)//q
+#     amount   = n * unit_price - discount
+# ---------------------------------------------------------------------------
+
+
+# --- Response-shape -----------------------------------------------------------
+
+def test_partial_refund_response_shape(client):
+    # Single eligible item, no coupon → pure unit-price refund
+    order = client.order_with({"TSHIRT": 2}, key="k1")
+    oid = order["order_id"]
+    resp = client.post(f"/orders/{oid}/refunds", {"items": [{"sku": "TSHIRT", "quantity": 1}]})
+    assert resp.status == 201
+    body = resp.body
+    assert body["order_id"] == oid
+    assert body["status"] == "refunded"
+    assert isinstance(body["refund_id"], str)
+    assert isinstance(body["amount_cents"], int)
+    assert isinstance(body["remaining_refundable_cents"], int)
+    assert body["items"] == [{"sku": "TSHIRT", "quantity": 1, "amount_cents": body["items"][0]["amount_cents"]}]
+
+
+# --- Criterion 2: one discounted item returns price minus allocated discount --
+
+def test_single_discounted_item_amount(client):
+    # TSHIRT x2, SAVE10 → discount=400, W=4000, TSHIRT gets full 400
+    # refund 1 unit: j=0, n=1, q=2, L=400 → disc=(400*1)//2 - 0 = 200 → amount=1800
+    order = client.order_with({"TSHIRT": 2}, "SAVE10", key="k1")
+    oid = order["order_id"]
+    resp = client.post(f"/orders/{oid}/refunds", {"items": [{"sku": "TSHIRT", "quantity": 1}]})
+    assert resp.status == 201
+    assert resp.body["items"][0] == {"sku": "TSHIRT", "quantity": 1, "amount_cents": 1800}
+    assert resp.body["amount_cents"] == 1800
+    assert resp.body["remaining_refundable_cents"] == order["payment"]["captured_cents"] - 1800
+
+
+def test_ineligible_line_gets_no_discount(client):
+    # TSHIRT x2 + GIFTCARD x1, SAVE10
+    # discount=400, W=4000 (TSHIRT only), GIFTCARD discount=0
+    # Refund GIFTCARD: amount = 5000 - 0 = 5000
+    order = client.order_with({"TSHIRT": 2, "GIFTCARD": 1}, "SAVE10", key="k1")
+    oid = order["order_id"]
+    resp = client.post(f"/orders/{oid}/refunds", {"items": [{"sku": "GIFTCARD", "quantity": 1}]})
+    assert resp.status == 201
+    assert resp.body["items"][0] == {"sku": "GIFTCARD", "quantity": 1, "amount_cents": 5000}
+
+
+# --- Criterion 3: multiple operations never exceed captured; full set equals captured ---
+
+def test_incremental_refunds_sum_to_captured(client):
+    # TSHIRT x2, SAVE10 → captured=3600
+    # unit 1: discount = (400*1)//2 - 0 = 200 → 1800
+    # unit 2: discount = (400*2)//2 - (400*1)//2 = 400-200 = 200 → 1800
+    order = client.order_with({"TSHIRT": 2}, "SAVE10", key="k1")
+    oid = order["order_id"]
+    captured = order["payment"]["captured_cents"]  # 3600
+    r1 = client.post(f"/orders/{oid}/refunds", {"items": [{"sku": "TSHIRT", "quantity": 1}]})
+    assert r1.status == 201
+    assert r1.body["amount_cents"] == 1800
+    assert r1.body["remaining_refundable_cents"] == 1800
+    r2 = client.post(f"/orders/{oid}/refunds", {"items": [{"sku": "TSHIRT", "quantity": 1}]})
+    assert r2.status == 201
+    assert r2.body["amount_cents"] == 1800
+    assert r2.body["remaining_refundable_cents"] == 0
+    assert r1.body["amount_cents"] + r2.body["amount_cents"] == captured
+
+
+def test_partial_then_full_refund_sums_to_captured(client):
+    # Partial refund one unit, then full-refund endpoint refunds the rest
+    order = client.order_with({"TSHIRT": 2}, "SAVE10", key="k1")
+    oid = order["order_id"]
+    captured = order["payment"]["captured_cents"]
+    r1 = client.post(f"/orders/{oid}/refunds", {"items": [{"sku": "TSHIRT", "quantity": 1}]})
+    assert r1.status == 201
+    r2 = client.post(f"/orders/{oid}/refund")
+    assert r2.status == 201
+    assert r1.body["amount_cents"] + r2.body["amount_cents"] == captured
+
+
+def test_refunding_all_units_sums_to_captured_multi_line(client):
+    # TSHIRT x1, MUG x1, SAVE10
+    # subtotal=3250, discount=(3250*10+50)//100=325
+    # W=3250 (both eligible)
+    # TSHIRT: floor(325*2000/3250)=200, MUG: floor(325*1250/3250)=125 → sum=325, no remainder
+    # captured=2925
+    # refund TSHIRT: 2000-200=1800; refund MUG: 1250-125=1125; total=2925
+    order = client.order_with({"TSHIRT": 1, "MUG": 1}, "SAVE10", key="k1")
+    oid = order["order_id"]
+    captured = order["payment"]["captured_cents"]  # 2925
+    r1 = client.post(f"/orders/{oid}/refunds", {"items": [{"sku": "TSHIRT", "quantity": 1}]})
+    r2 = client.post(f"/orders/{oid}/refunds", {"items": [{"sku": "MUG", "quantity": 1}]})
+    assert r1.status == 201 and r2.status == 201
+    assert r1.body["amount_cents"] + r2.body["amount_cents"] == captured
+
