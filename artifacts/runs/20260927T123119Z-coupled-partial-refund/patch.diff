+# --- Criterion 4: Deterministic rounding (remainder distribution) -------------
+
+def test_remainder_cent_goes_to_highest_modulo_line(client):
+    # TSHIRT x1 + MUG x1, SAVE25
+    # subtotal=3250; discount=(3250*25+50)//100=813
+    # W=3250
+    # TSHIRT (w=2000): floor(813*2000/3250)=500, mod=813*2000%3250=1000
+    # MUG    (w=1250): floor(813*1250/3250)=312, mod=813*1250%3250=2250
+    # sum=812, remainder=1 → MUG gets +1 (mod 2250 > 1000)
+    # TSHIRT discount=500, MUG discount=313
+    # captured = 3250-813=2437
+    order = client.order_with({"TSHIRT": 1, "MUG": 1}, "SAVE25", key="k1")
+    oid = order["order_id"]
+    r1 = client.post(f"/orders/{oid}/refunds", {"items": [{"sku": "TSHIRT", "quantity": 1}]})
+    r2 = client.post(f"/orders/{oid}/refunds", {"items": [{"sku": "MUG", "quantity": 1}]})
+    assert r1.body["items"][0]["amount_cents"] == 1500  # 2000-500
+    assert r2.body["items"][0]["amount_cents"] == 937   # 1250-313
+    assert r1.body["amount_cents"] + r2.body["amount_cents"] == order["payment"]["captured_cents"]
+
+
+def test_multi_unit_line_discount_is_deterministic(client):
+    # TSHIRT x3, SAVE10 → subtotal=6000, discount=(6000*10+50)//100=600
+    # W=6000, TSHIRT gets 600
+    # unit 1: (600*1)//3 - 0 = 200 → 1800
+    # unit 2: (600*2)//3 - (600*1)//3 = 400-200 = 200 → 1800
+    # unit 3: (600*3)//3 - (600*2)//3 = 600-400 = 200 → 1800
+    order = client.order_with({"TSHIRT": 3}, "SAVE10", key="k1")
+    oid = order["order_id"]
+    captured = order["payment"]["captured_cents"]  # 5400
+    r1 = client.post(f"/orders/{oid}/refunds", {"items": [{"sku": "TSHIRT", "quantity": 1}]})
+    r2 = client.post(f"/orders/{oid}/refunds", {"items": [{"sku": "TSHIRT", "quantity": 1}]})
+    r3 = client.post(f"/orders/{oid}/refunds", {"items": [{"sku": "TSHIRT", "quantity": 1}]})
+    assert r1.body["amount_cents"] == 1800
+    assert r2.body["amount_cents"] == 1800
+    assert r3.body["amount_cents"] == 1800
+    assert r1.body["amount_cents"] + r2.body["amount_cents"] + r3.body["amount_cents"] == captured
+
