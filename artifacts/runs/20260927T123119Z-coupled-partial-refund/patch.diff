+
+def allocate_line_discounts(lines: list[tuple], discount_cents: int) -> list[int]:
+    """Allocate discount_cents across eligible lines using floor + remainder distribution.
+
+    `lines` are (sku, quantity, unit_price_cents, coupon_eligible).
+    Returns a list of per-line discount amounts (cents), same order as lines.
+    Lines that are not coupon_eligible receive 0.
+
+    Rule: Let D = discount_cents, W = sum of line_total_cents over eligible lines.
+    Line i receives floor(D * w_i / W) cents.
+    Remaining cents are given one each to lines by descending (D * w_i mod W),
+    ties broken by ascending line position.
+    """
+    if discount_cents == 0:
+        return [0] * len(lines)
+
+    # Compute W (sum of eligible line totals) and per-line weights
+    eligible_total = 0
+    for line in lines:
+        sku, quantity, unit_price = line[0], line[1], line[2]
+        is_eligible = line[3] if len(line) >= 4 else True
+        if is_eligible:
+            eligible_total += quantity * unit_price
+
+    if eligible_total == 0:
+        return [0] * len(lines)
+
+    D = discount_cents
+    W = eligible_total
+
+    # Floor allocation
+    allocated = []
+    for i, line in enumerate(lines):
+        sku, quantity, unit_price = line[0], line[1], line[2]
+        is_eligible = line[3] if len(line) >= 4 else True
+        if is_eligible:
+            w_i = quantity * unit_price
+            allocated.append(D * w_i // W)
+        else:
+            allocated.append(0)
+
+    # Distribute remainder
+    remainder = D - sum(allocated)
+    if remainder > 0:
+        # Sort eligible indices by descending remainder, ties by ascending position
+        eligible_indices = []
+        for i, line in enumerate(lines):
+            sku, quantity, unit_price = line[0], line[1], line[2]
+            is_eligible = line[3] if len(line) >= 4 else True
+            if is_eligible:
+                w_i = quantity * unit_price
+                mod_val = (D * w_i) % W
+                eligible_indices.append((i, mod_val))
+        eligible_indices.sort(key=lambda x: (-x[1], x[0]))
+        for i in range(remainder):
+            idx = eligible_indices[i][0]
+            allocated[idx] += 1
+
+    return allocated
