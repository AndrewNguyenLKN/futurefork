+# --- Criterion 5: Amounts use checkout-time pricing, not current catalog ------
+
+def test_partial_refund_amount_uses_checkout_price(client):
+    # The order stores unit_price_cents at checkout; even if catalog changed the
+    # price would be irrelevant. We verify the amount matches what was stored,
+    # not any live catalog lookup.
+    order = client.order_with({"TSHIRT": 1}, key="k1")
+    oid = order["order_id"]
+    stored_price = order["items"][0]["unit_price_cents"]
+    resp = client.post(f"/orders/{oid}/refunds", {"items": [{"sku": "TSHIRT", "quantity": 1}]})
+    assert resp.status == 201
+    # No discount on this order, so refund = stored unit price
+    assert resp.body["items"][0]["amount_cents"] == stored_price
+
